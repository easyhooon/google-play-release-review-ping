# Google Application Default Credentials가 읽을 서비스 계정 JSON 경로
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# 전역 기본 채널. 하나 이상 설정하면 지정한 채널에 모두 전송합니다.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# 앱별 채널 예시. watch.config.json에는 URL 대신 이 이름을 지정합니다.
# DISCORD_WEBHOOK_URL_YEOBEE=
# TEAMS_WEBHOOK_URL_COMPANY=
